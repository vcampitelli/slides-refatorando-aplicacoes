#!/bin/bash
base_url="http://localhost:8080"

case "$1" in
  listar)
    command=$base_url/products
    ;;

  visualizar-valido)
    command=$base_url/products/1
    ;;

  visualizar-invalido)
    command=$base_url/products/10
    ;;

  cadastrar-sem-nenhuma-informacao)
    command=-X POST $base_url/products
    ;;

  cadastrar-categoria-invalida)
    command=-X POST -d 'id_category=erro' $base_url/products
    ;;

  cadastrar-sem-nome)
    command=-X POST -d 'id_category=1' $base_url/products
    ;;

  cadastrar-nome-muito-curto)
    command=-X POST -d 'id_category=1&name=A' $base_url/products
    ;;

  cadastrar-nome-muito-longo)
    command=-X POST -d 'id_category=1&name=Meu+nome+de+produto+muito+grande' $base_url/products
    ;;

  cadastrar-sem-sku)
    command=-X POST -d 'id_category=1&name=Meu+produto' $base_url/products
    ;;

  cadastrar-sku-invalido)
    command=-X POST -d 'id_category=1&name=Meu+produto&sku=TESTE' $base_url/products
    ;;

  cadastrar-sem-preco)
    command=-X POST -d 'id_category=1&name=Meu+produto&sku=TESTE00000' $base_url/products
    ;;

  cadastrar-preco-invalido)
    command=-X POST -d 'id_category=1&name=Meu+produto&sku=TESTE00000&price=0' $base_url/products
    ;;

  cadastrar-valido)
    command=-X POST -d 'id_category=1&name=Meu+produto&sku=TESTE00000&price=10' $base_url/products
    ;;

  cadastrar-lote)
    command=-X POST -d 'products[0][id_category]=1&products[0][name]=Meu+produto+1&products[0][sku]=BULK000001&products[0][price]=10&products[1][id_category]=2&products[1][name]=Meu+produto+2&products[1][sku]=BULK000002&products[1][price]=20' $base_url/products/bulk
    ;;

  *)
    color_green="\e[32m"
    color_yellow="\e[33m"
    color_reset="\e[0m"
    echo -e "${color_yellow}Uso:${color_reset}"
    echo "  $0 <comando>"
    echo ""
    echo -e "${color_yellow}Comandos:${color_reset}"
    echo -e "  ${color_green}listar                            ${color_reset}Listar produtos"
    echo -e "  ${color_green}visualizar-valido                 ${color_reset}Visualizar produto com ID válido"
    echo -e "  ${color_green}visualizar-invalido               ${color_reset}Visualizar produto com ID inválido"
    echo -e "  ${color_green}cadastrar-sem-nenhuma-informacao  ${color_reset}Cadastrar produto sem nenhuma informação"
    echo -e "  ${color_green}cadastrar-categoria-invalida      ${color_reset}Cadastrar produto com categoria inválida"
    echo -e "  ${color_green}cadastrar-sem-nome                ${color_reset}Cadastrar produto sem nome"
    echo -e "  ${color_green}cadastrar-nome-muito-curto        ${color_reset}Cadastrar produto com nome muito curto"
    echo -e "  ${color_green}cadastrar-nome-muito-longo        ${color_reset}Cadastrar produto com nome muito longo"
    echo -e "  ${color_green}cadastrar-sem-sku                 ${color_reset}Cadastrar produto sem SKU"
    echo -e "  ${color_green}cadastrar-sku-invalido            ${color_reset}Cadastrar produto com SKU inválido"
    echo -e "  ${color_green}cadastrar-sem-preco               ${color_reset}Cadastrar produto sem preço"
    echo -e "  ${color_green}cadastrar-preco-invalido          ${color_reset}Cadastrar produto com preço inválido"
    echo -e "  ${color_green}cadastrar-valido                  ${color_reset}Cadastrar produto com todas as informações corretas"
    echo -e "  ${color_green}cadastrar-lote                    ${color_reset}Cadastrar produtos em lote"
    exit 1
    ;;
esac

if ! command -v jq &> /dev/null
then
  curl "$command"
  exit 0
else
  curl -s "$command" | jq
fi
